  "tokenColors": [
    {
      "name": "Quiet rooftop notes",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A59EB8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control flow and modifiers",
      "scope": [
        "keyword.control",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other.using",
        "keyword.other.namespace"
      ],
      "settings": {
        "foreground": "#C4A7E7"
      }
    },
    {
      "name": "Storage and declarations",
      "scope": [
        "keyword",
        "storage.type.struct",
        "storage.type.class",
        "storage.type.enum",
        "storage.type.interface",
        "storage.type.template",
        "keyword.other.template",
        "keyword.other.typedef"
      ],
      "settings": {
        "foreground": "#C4A7E7"
      }
    },
    {
      "name": "Type keywords and primitives",
      "scope": [
        "storage.type",
        "support.type.primitive",
        "storage.type.built-in",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#89B4FA"
      }
    },
    {
      "name": "Comparison and logical operators",
      "scope": [
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.bitwise"
      ],
      "settings": {
        "foreground": "#89DCEB"
      }
    },
    {
      "name": "Accessors and separators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section.brackets"
      ],
      "settings": {
        "foreground": "#A59EB8"
      }
    },
    {
      "name": "Lantern values and numbers",
      "scope": [
        "constant.numeric",
        "keyword.other.unit",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#F28FAD"
      }
    },
    {
      "name": "Named constants",
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#F2A365"
      }
    },
    {
      "name": "Garden strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A9C799"
      }
    },
    {
      "name": "Electric functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#92C4D8"
      }
    },
    {
      "name": "Skyline types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#EBC47A"
      }
    },
    {
      "name": "Namespaces, macros and type parameters",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.name.type.parameter",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#8BD5CA"
      }
    },
    {
      "name": "Attributes and annotations",
      "scope": [
        "meta.attribute",
        "entity.other.attribute-name",
        "storage.type.annotation",
        "support.other.attribute"
      ],
      "settings": {
        "foreground": "#8BD5CA"
      }
    },
    {
      "name": "Member fields and properties",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "support.variable.property",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#F2A365"
      }
    },
    {
      "name": "Object receivers",
      "scope": [
        "variable.other.object",
        "variable.other.object.access"
      ],
      "settings": {
        "foreground": "#ECE4DC"
      }
    },
    {
      "name": "Function parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#B4BEFE"
      }
    },
    {
      "name": "Readable variables",
      "scope": [
        "variable",
        "meta.definition.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#ECE4DC"
      }
    },
    {
      "name": "Built-ins and this/self",
      "scope": [
        "variable.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#F28FAD"
      }
    },
    {
      "name": "Markup tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#89B4FA"
      }
    },
    {
      "name": "Object keys",
      "scope": [
        "support.type.property-name",
        "entity.name.tag.yaml",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#F2A365"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#F2A365"
      }
    },
    {
      "name": "Escaped light",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#EBC47A"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E87D72"
      }
    },
    {
      "name": "Markdown titles",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#F2A365",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#EBC47A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#89B4FA",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#A9C799"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A9C799"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E87D72"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8BD5CA",
    "type": "#EBC47A",
    "class": "#EBC47A",
    "struct": "#EBC47A",
    "interface": "#EBC47A",
    "enum": "#EBC47A",
    "typeParameter": "#8BD5CA",
    "function": "#92C4D8",
    "method": "#92C4D8",
    "macro": "#8BD5CA",
    "decorator": "#8BD5CA",
    "parameter": "#B4BEFE",
    "variable": "#ECE4DC",
    "property": "#F2A365",
    "variable.readonly": "#F2A365",
    "property.readonly": "#F2A365",
    "variable.defaultLibrary": "#F28FAD",
    "enumMember": "#8BD5CA",
    "keyword": "#C4A7E7",
    "modifier": "#C4A7E7",
    "operator": "#89DCEB",
    "number": "#F28FAD",
    "string": "#A9C799",
    "comment": {
      "foreground": "#A59EB8",
      "italic": true
    }
  }
}
