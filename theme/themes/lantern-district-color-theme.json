  "tokenColors": [
    {
      "name": "Quiet rooftop notes",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#91A0B8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "City language",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#91B5FF"
      }
    },
    {
      "name": "Signals and operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#91A0B8"
      }
    },
    {
      "name": "Lantern values",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#F2AB79"
      }
    },
    {
      "name": "Garden strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#AED7B0"
      }
    },
    {
      "name": "Electric functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7DDCE9"
      }
    },
    {
      "name": "Skyline types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#E6C482"
      }
    },
    {
      "name": "Readable variables",
      "scope": [
        "variable",
        "meta.definition.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#D9E2F0"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C4CFE2"
      }
    },
    {
      "name": "Built-ins",
      "scope": [
        "variable.language",
        "support.variable"
      ],
      "settings": {
        "foreground": "#B8ADF0"
      }
    },
    {
      "name": "Markup tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#91B5FF"
      }
    },
    {
      "name": "Markup attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7DDCE9"
      }
    },
    {
      "name": "Object keys",
      "scope": [
        "support.type.property-name",
        "entity.name.tag.yaml",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#AEC9EC"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#F2AB79"
      }
    },
    {
      "name": "Escaped light",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#E6C482"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FF8593"
      }
    },
    {
      "name": "Markdown titles",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#7DDCE9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E6C482",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#91B5FF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#AED7B0"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#AED7B0"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF8593"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#E6C482",
    "type": "#E6C482",
    "class": "#E6C482",
    "interface": "#E6C482",
    "enum": "#E6C482",
    "typeParameter": "#E6C482",
    "function": "#7DDCE9",
    "method": "#7DDCE9",
    "parameter": "#C4CFE2",
    "variable": "#D9E2F0",
    "property": "#AEC9EC",
    "variable.readonly": "#F2AB79",
    "property.readonly": "#F2AB79",
    "enumMember": "#F2AB79",
    "keyword": "#91B5FF",
    "number": "#F2AB79",
    "string": "#AED7B0",
    "comment": {
      "foreground": "#91A0B8",
      "italic": true
    }
  }
}
