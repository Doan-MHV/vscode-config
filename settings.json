{
  "workbench.colorTheme": "Lantern District",
  "workbench.iconTheme": "lantern-district-icons",
  "workbench.preferredDarkColorTheme": "Lantern District",
  "window.autoDetectColorScheme": false,
  "window.titleBarStyle": "custom",
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "workbench.activityBar.location": "top",
  "workbench.sideBar.location": "left",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.editor.tabSizing": "fit",
  "workbench.editor.showTabs": "single",
  "workbench.editor.editorActionsLocation": "default",
  "workbench.editor.labelFormat": "default",
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.list.smoothScrolling": true,
  "workbench.startupEditor": "none",
  "breadcrumbs.enabled": false,
  "explorer.compactFolders": true,
  "explorer.decorations.badges": false,
  "editor.fontFamily": "'Cascadia Code', 'JetBrains Mono', Consolas, Menlo, monospace",
  "editor.fontSize": 16,
  "editor.fontWeight": "400",
  "editor.fontLigatures": true,
  "editor.lineHeight": 26,
  "editor.letterSpacing": 0,
  "editor.minimap.enabled": false,
  "editor.lineNumbers": "on",
  "editor.lineNumbersMinChars": 3,
  "editor.glyphMargin": true,
  "editor.codeLens": false,
  "editor.lightbulb.enabled": "on",
  "editor.padding.top": 16,
  "editor.padding.bottom": 16,
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "block",
  "editor.cursorWidth": 2,
  "editor.renderLineHighlight": "gutter",
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.renderWhitespace": "selection",
  "editor.guides.indentation": false,
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.scrollbar.horizontalScrollbarSize": 8,
  "editor.overviewRulerBorder": false,
  "editor.stickyScroll.enabled": false,
  "terminal.integrated.fontFamily": "'Cascadia Code NF', 'JetBrainsMono Nerd Font', 'Cascadia Code', Consolas, monospace",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.tabs.enabled": false,
  "window.density.editorTabHeight": "compact",
  "editor.suggestFontSize": 16,
  "editor.suggestLineHeight": 24,
  "editor.inlayHints.fontSize": 13,
  "debug.console.fontSize": 16,
  "debug.console.fontFamily": "'Cascadia Code', 'JetBrains Mono', Consolas, Menlo, monospace",
  "workbench.colorCustomizations": {
    "[Lantern District]": {
      "quickInput.background": "#13121F",
      "quickInput.foreground": "#ECE4DC",
      "quickInputTitle.background": "#13121F",
      "quickInputList.focusBackground": "#2C2744",
      "quickInputList.focusForeground": "#F7EFE6",
      "quickInputList.focusIconForeground": "#F2A365",
      "quickInputList.focusHighlightForeground": "#F2A365",
      "pickerGroup.border": "#00000000",
      "pickerGroup.foreground": "#C4A7E7",
      "input.background": "#161524",
      "input.border": "#363152",
      "input.foreground": "#ECE4DC",
      "input.placeholderForeground": "#9A93B0",
      "focusBorder": "#00000000",
      "widget.border": "#2A2640",
      "widget.shadow": "#00000000",
      "scrollbar.shadow": "#00000000",
      "editorOverviewRuler.border": "#00000000",
      "sideBar.border": "#ffffff08",
      "panel.border": "#ffffff08",
      "statusBar.border": "#ffffff08",
      "titleBar.border": "#00000000",
      "keybindingLabel.background": "#221F36",
      "keybindingLabel.foreground": "#B6AFCB",
      "keybindingLabel.border": "#00000000",
      "keybindingLabel.bottomBorder": "#00000000"
    }
  },
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "[cuda-cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "cmake.useCMakePresets": "auto",
  "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
  "python.pyrefly.diagnosticMode": "openFilesOnly",
  "python.useEnvironmentsExtension": false,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[csharp]": {
    "editor.defaultFormatter": "nromanov.dotrush",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },
  "editor.inlineSuggest.suppressSuggestions": false,
  "git.autofetch": true,
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning"
  ],
  "errorLens.messageBackgroundMode": "none",
  "errorLens.followCursor": "allLinesExceptActive",
  "errorLens.delay": 500,
  "errorLens.messageTemplate": "  ── $message"
}
